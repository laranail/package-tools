#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Run a package's database tests against real engines from simtabi/dbpantry, one isolated database
 * per run.
 *
 *     vendor/bin/laranail-test-db [--connection=<name>] [-- test args]
 *                                                   boot dbpantry's fixture, create this run's own
 *                                                   databases, run the test group on each connection;
 *                                                   --connection (repeatable) runs only the ones named
 *     vendor/bin/laranail-test-db env <connection> [--reveal]
 *                                                   create a run's database and print its DB_* variables;
 *                                                   DB_PASSWORD is masked unless --reveal is given
 *     vendor/bin/laranail-test-db down              stop the fixture (it holds no data worth keeping)
 *
 * Configuration lives in the consuming package's composer.json:
 *
 *     "extra": { "laranail": { "test-db": {
 *         "connections": ["mysql", "pgsql"],   required: Laravel connection names, run in this order
 *         "group": "database",                 the test group (default: database; null runs every test)
 *         "args": ["tests/Feature/A.php"],     arguments always passed to the runner, before yours
 *         "project": "settings",               the database name prefix (default: the package name)
 *         "principal": "app",                  app (the project's owner role) or admin (the engine's)
 *         "together": false,                   true: one run with every connection's variables at once
 *         "env": {"DB_PORT": "{port}"}         the variables a run gets (default: DB_CONNECTION, DB_HOST,
 *                                              DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD); names and
 *                                              values take {connection} {CONNECTION} {engine} {host} {port}
 *                                              {database} {user} {password}
 *     } } }
 *
 * dbpantry is found through DBPANTRY_DIR, or else as simtabi/packages/dbpantry above this package.
 * Its fixture runs beside its long-lived stack, on tmpfs with durability off, and publishes at
 * MDB_FIXTURE_PORT_BASE (55000) + offset; it needs MDB_PUBLISH=direct in dbpantry's .env. Ports,
 * users and password files come from `make endpoints`, never from a copy here.
 *
 * Each run creates its own project, <project>_r<8 hex>, so two runs never share a database: the
 * laranail/settings pilot (2026-11-17) saw 121 failures when two runs shared one. The fixture stays
 * up for the next run; `down` stops it and drops every run's password files with it.
 */

/** Laravel connection name => dbpantry engine. */
const ENGINES = ['pgsql' => 'pg', 'mysql' => 'mysql', 'mariadb' => 'mariadb'];

/** The variables a run gets when the package names none: Laravel's own. */
const DEFAULT_ENV = [
    'DB_CONNECTION' => '{connection}',
    'DB_HOST'       => '{host}',
    'DB_PORT'       => '{port}',
    'DB_DATABASE'   => '{database}',
    'DB_USERNAME'   => '{user}',
    'DB_PASSWORD'   => '{password}',
];

function fail(string $message): never
{
    fwrite(STDERR, 'laranail-test-db: ' . $message . "\n");
    exit(1);
}

function say(string $message): void
{
    fwrite(STDERR, 'laranail-test-db: ' . $message . "\n");
}

/**
 * The test-db block of the consuming package's composer.json.
 *
 * @return array{connections: list<string>, group: ?string, args: list<string>, project: string, principal: string, together: bool, env: array<string, string>}
 */
function config(string $root): array
{
    $file = $root . '/composer.json';
    if (! is_file($file)) {
        fail("no composer.json in {$root}; run this from the package root");
    }
    $composer = json_decode((string) file_get_contents($file), true);
    if (! is_array($composer)) {
        fail("{$file} is not valid JSON");
    }
    $block = $composer['extra']['laranail']['test-db'] ?? null;
    if (! is_array($block) || ! isset($block['connections']) || ! is_array($block['connections']) || $block['connections'] === []) {
        fail('composer.json has no extra.laranail.test-db.connections, e.g. ["mysql", "pgsql"]');
    }
    $connections = [];
    foreach ($block['connections'] as $connection) {
        if (! is_string($connection) || ! isset(ENGINES[$connection])) {
            fail('unknown connection ' . json_encode($connection) . '; use ' . implode(', ', array_keys(ENGINES)));
        }
        $connections[] = $connection;
    }
    $name = is_string($composer['name'] ?? null) ? substr((string) strrchr('/' . $composer['name'], '/'), 1) : 'app';
    $project = is_string($block['project'] ?? null) ? $block['project'] : $name;
    $project = (string) preg_replace('/[^a-z0-9_]+/', '_', strtolower($project));
    if (preg_match('/^[a-z]/', $project) !== 1) {
        $project = 'p_' . $project;
    }

    // group: absent means "database"; null means no --group, so the whole suite (or args) runs.
    $group = array_key_exists('group', $block) ? $block['group'] : 'database';
    if ($group !== null && (! is_string($group) || $group === '')) {
        fail('extra.laranail.test-db.group must be a group name or null');
    }
    $args = $block['args'] ?? [];
    if (! is_array($args) || array_filter($args, static fn (mixed $a): bool => ! is_string($a)) !== []) {
        fail('extra.laranail.test-db.args must be a list of strings');
    }
    $principal = $block['principal'] ?? 'app';
    if (! in_array($principal, ['app', 'admin'], true)) {
        fail('extra.laranail.test-db.principal must be app or admin');
    }
    $together = $block['together'] ?? false;
    if (! is_bool($together)) {
        fail('extra.laranail.test-db.together must be true or false');
    }
    $env = $block['env'] ?? DEFAULT_ENV;
    if (! is_array($env) || $env === [] || array_filter($env, static fn (mixed $v): bool => ! is_string($v)) !== []) {
        fail('extra.laranail.test-db.env must map variable names to string templates');
    }
    // One run with several connections needs a variable name per connection, or the second
    // connection's values silently replace the first's.
    if ($together && count($connections) > 1) {
        foreach (array_keys($env) as $name) {
            if (! preg_match('/\{(connection|CONNECTION|engine)\}/', (string) $name)) {
                fail("with together, every env name must contain {CONNECTION} (or {connection}, {engine}); {$name} does not");
            }
        }
    }

    return [
        'connections' => $connections,
        'group'       => $group,
        'args'        => array_values($args),
        // new-project allows 63 characters; leave room for _r + 8 hex.
        'project'   => substr($project, 0, 52),
        'principal' => $principal,
        'together'  => $together,
        'env'       => $env,
    ];
}

/** dbpantry's checkout: DBPANTRY_DIR, else simtabi/packages/dbpantry in an ancestor of $root. */
function pantry(string $root): string
{
    $explicit = getenv('DBPANTRY_DIR');
    if (is_string($explicit) && $explicit !== '') {
        $dir = realpath($explicit);
        if ($dir === false || ! is_file($dir . '/Makefile')) {
            fail("DBPANTRY_DIR={$explicit} is not a dbpantry checkout");
        }

        return $dir;
    }
    for ($dir = $root; $dir !== dirname($dir); $dir = dirname($dir)) {
        $candidate = $dir . '/simtabi/packages/dbpantry';
        if (is_file($candidate . '/Makefile')) {
            return (string) realpath($candidate);
        }
    }
    fail('dbpantry not found: set DBPANTRY_DIR to its checkout');
}

/** Run make in dbpantry, failing with its output on a non-zero exit. Returns stdout. */
function make(string $pantry, string ...$args): string
{
    $command = array_merge(['make', '-s', '-C', $pantry], $args);
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
    if (! is_resource($process)) {
        fail('could not run make');
    }
    $out = (string) stream_get_contents($pipes[1]);
    $err = (string) stream_get_contents($pipes[2]);
    if (proc_close($process) !== 0) {
        fail('make ' . implode(' ', $args) . " failed:\n" . $err . $out);
    }

    return $out;
}

/** The engines for the configured connections, as dbpantry profiles. */
function profiles(array $config): string
{
    return implode(',', array_values(array_unique(array_map(static fn (string $c): string => ENGINES[$c], $config['connections']))));
}

/**
 * Boot the fixture and create a fresh project for this run on every engine. Returns the project
 * name and, per connection, the values the env templates read.
 *
 * @return array{0: string, 1: array<string, array<string, string>>}
 */
function provision(string $pantry, array $config): array
{
    $profiles = profiles($config);
    $run = $config['project'] . '_r' . bin2hex(random_bytes(4));

    say("starting dbpantry's fixture ({$profiles})");
    make($pantry, 'fixture-up', 'PROFILES=' . $profiles);
    foreach (explode(',', $profiles) as $engine) {
        say("creating {$run} on {$engine}");
        make($pantry, 'new-project', 'NAME=' . $run, 'ENGINE=' . $engine, 'FIXTURE=1');
    }

    $document = json_decode(make($pantry, 'endpoints', 'OUTPUT=json', 'PROFILES=' . $profiles, 'PROJECT=' . $run, 'FIXTURE=1'), true);
    if (! is_array($document) || ($document['fixture'] ?? false) !== true) {
        fail('dbpantry endpoints did not describe the fixture; dbpantry needs fixture support (simtabi/dbpantry#37)');
    }

    $values = [];
    foreach ($config['connections'] as $connection) {
        $engine = ENGINES[$connection];
        $endpoint = null;
        foreach ($document['endpoints'] ?? [] as $candidate) {
            if (($candidate['engine'] ?? null) === $engine) {
                $endpoint = $candidate;
            }
        }
        $port = $endpoint['direct']['published']['port'] ?? null;
        if (! is_int($port)) {
            fail("dbpantry publishes no host port for {$engine}; set MDB_PUBLISH=direct in its .env");
        }
        $chosen = null;
        foreach ($endpoint['principals'] ?? [] as $principal) {
            if (($principal['role'] ?? null) === $config['principal']) {
                $chosen = $principal;
            }
        }
        $secret = is_string($chosen['password_file'] ?? null) ? $chosen['password_file'] : '';
        $secret = $pantry . '/secrets/' . preg_replace('#^/run/secrets/#', '', $secret);
        if (! is_string($chosen['user'] ?? null)) {
            fail($config['principal'] === 'admin'
                ? "dbpantry's endpoints name no admin user for {$engine}; principal admin needs a dbpantry that reports it"
                : "no {$engine} project {$run} in dbpantry's fixture");
        }
        if (! is_readable($secret)) {
            fail("no password file for the {$config['principal']} principal on {$engine} (looked for {$secret})");
        }
        $values[$connection] = [
            'connection' => $connection,
            'CONNECTION' => strtoupper($connection),
            'engine'     => $engine,
            'host'       => '127.0.0.1',
            'port'       => (string) $port,
            'database'   => $run,
            'user'       => $chosen['user'],
            'password'   => trim((string) file_get_contents($secret)),
        ];
    }

    return [$run, $values];
}

/**
 * The env templates for one connection, with every {placeholder} filled in. A value whose template
 * holds {password} is masked unless $reveal.
 *
 * @param array<string, string> $templates
 * @param array<string, string> $values
 *
 * @return array<string, string>
 */
function render(array $templates, array $values, bool $reveal = true): array
{
    $fill = static fn (string $t): string => strtr($t, array_combine(
        array_map(static fn (string $k): string => '{' . $k . '}', array_keys($values)),
        array_values($values),
    ));
    $out = [];
    foreach ($templates as $name => $template) {
        $out[$fill((string) $name)] = ! $reveal && str_contains($template, '{password}') ? '***' : $fill($template);
    }

    return $out;
}

/** The consuming package's test runner: Pest when installed, else PHPUnit. */
function runner(string $root): string
{
    foreach (['pest', 'phpunit'] as $binary) {
        if (is_file($root . '/vendor/bin/' . $binary)) {
            return $root . '/vendor/bin/' . $binary;
        }
    }
    fail('neither vendor/bin/pest nor vendor/bin/phpunit exists; run composer install');
}

$root = (string) getcwd();
$args = array_slice($argv, 1);
$command = $args[0] ?? 'run';
if ($command === '--' || str_starts_with($command, '--connection')) {
    $command = 'run';
} elseif (in_array($command, ['run', 'env', 'down'], true)) {
    array_shift($args);
} elseif (in_array($command, ['-h', '--help', 'help'], true)) {
    // The doc block at the top of this file, whole: a fixed line slice cut it short once it grew.
    preg_match('#/\*\*\n(.*?)\n \*/#s', (string) file_get_contents(__FILE__), $doc);
    echo preg_replace('/^ \* ?/m', '', $doc[1] ?? ''), "\n";
    exit(0);
} else {
    fail("unknown command {$command}; use run, env or down");
}
// --connection=<name> (repeatable, before --) narrows a run to the connections named, in the
// configured order: to compare engines one at a time, or to rerun only the one that failed.
$only = [];
while (isset($args[0]) && str_starts_with($args[0], '--connection')) {
    $option = (string) array_shift($args);
    $value = str_contains($option, '=') ? substr($option, strlen('--connection=')) : (string) array_shift($args);
    if ($value === '') {
        fail('--connection needs a name, e.g. --connection=pgsql');
    }
    $only[] = $value;
}
if (($args[0] ?? null) === '--') {
    array_shift($args);
}

$config = config($root);
if ($only !== []) {
    if ($command !== 'run') {
        fail('--connection applies to a run, not to ' . $command);
    }
    foreach ($only as $connection) {
        if (! in_array($connection, $config['connections'], true)) {
            fail("{$connection} is not in extra.laranail.test-db.connections");
        }
    }
    $config['connections'] = array_values(array_filter($config['connections'], static fn (string $c): bool => in_array($c, $only, true)));
}
$pantry = pantry($root);

if ($command === 'down') {
    make($pantry, 'fixture-down');
    say('fixture stopped');
    exit(0);
}

if ($command === 'env') {
    $connection = $args[0] ?? fail('env needs a connection, e.g. env mysql');
    if (! in_array($connection, $config['connections'], true)) {
        fail("{$connection} is not in extra.laranail.test-db.connections");
    }
    // Masked by default, as settings' bin/test-db masked it: `env` output lands in
    // terminals, scrollback and pasted logs. --reveal prints it for `export $(...)`.
    $reveal = in_array('--reveal', array_slice($args, 1), true);
    [, $values] = provision($pantry, $config);
    foreach (render($config['env'], $values[$connection], $reveal) as $key => $value) {
        echo $key, '=', $value, "\n";
    }
    exit(0);
}

[$run, $values] = provision($pantry, $config);
$binary = runner($root);
$runnerArgs = array_merge($config['group'] === null ? [] : ['--group=' . $config['group']], $config['args'], $args);
$scope = $config['group'] === null ? 'tests' : "{$config['group']} group";

// together: one run that gets every connection's variables; otherwise one run per connection.
$runs = [];
if ($config['together']) {
    $env = [];
    foreach ($values as $connection => $v) {
        $env += render($config['env'], $v);
    }
    $runs[implode('+', array_keys($values))] = $env;
} else {
    foreach ($values as $connection => $v) {
        $runs[$connection] = render($config['env'], $v);
    }
}

$failed = [];
foreach ($runs as $label => $env) {
    say("{$scope} on {$label} ({$run})");
    $process = proc_open(
        array_merge([PHP_BINARY, $binary], $runnerArgs),
        // No descriptors: the child inherits ours as they are. Passing STDOUT/STDERR made PHP
        // cast each stream to its fd, seeking it to that stream's own (stale) position, so with
        // `> file 2>&1` every run after the first wrote over earlier output.
        [],
        $pipes,
        $root,
        array_merge(getenv(), $env),
    );
    if (! is_resource($process) || proc_close($process) !== 0) {
        $failed[] = $label;
    }
}

say($failed === [] ? 'all connections passed' : 'failed on: ' . implode(', ', $failed));
say("{$run} stays in the fixture until `vendor/bin/laranail-test-db down`");
exit($failed === [] ? 0 : 1);
