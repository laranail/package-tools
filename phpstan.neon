includes:
    - vendor/larastan/larastan/extension.neon
    - presets/phpstan.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - src
    excludePaths:
        - vendor
        - tests/_output (?)
        - tests/fixtures
    ignoreErrors:
        # larastan 3.x reports every package view namespace this way: the namespace is
        # registered at RUNTIME by the service provider, and PHPStan does not execute that, so
        # it cannot resolve the literal to a file. The views all exist.
        - '#expects view-string, string given#'
        # HasErrorStorage and HasGuzzleConfig are public-API traits — they
        # exist to be `use`-d by external package authors. PHPStan only
        # scans src/ and can't observe consumers, so it would always
        # report "trait used zero times" for these two. tests/Unit/Support
        # /Concerns/ has Pest coverage proving they behave correctly.
        - '#Trait Simtabi\\Laranail\\Package\\Tools\\Support\\Concerns\\(HasErrorStorage|HasGuzzleConfig) is used zero times#'
        # HasProgressBar and ManagesComposer are likewise consumer-facing
        # extension traits — `use`-d by external command / package classes,
        # so PHPStan (which scans only src/) always reports them as unused.
        - '#Trait Simtabi\\Laranail\\Package\\Tools\\Concerns\\Commands\\HasProgressBar is used zero times#'
        - '#Trait Simtabi\\Laranail\\Package\\Tools\\Concerns\\Package\\ManagesComposer is used zero times#'

    # Required BECAUSE of the ignore above: only larastan 3.x emits that error, and `composer
    # update` on CI resolves a newer larastan than a long-lived local vendor/ has. With the
    # default (true), the pattern would itself be an unmatched-ignore ERROR wherever the older
    # larastan is installed -- moving the failure rather than fixing it.
    reportUnmatchedIgnoredErrors: false
